$C = "../../Common.ui";
Group { Anchor: (Width: 680, Height: 760); Background: #0e1822; Padding: 20; LayoutMode: Top;
Label #Title { Anchor: (Height: 28); Text: "LOAD AMMUNITION"; Style: (FontSize: 20, TextColor: #dfc797); }
Label #Weapon { Anchor: (Height: 26); Style: (FontSize: 16, TextColor: #ffffff); }
Label #Hint { Anchor: (Height: 44); Style: (FontSize: 12, TextColor: #dfc797); }
Label #Empty { Anchor: (Height: 32); Visible: false; Style: (FontSize: 14, TextColor: #dfc797); }
Group #Row0 { LayoutMode: Left; Anchor: (Height: 50); ItemGrid #Icon0 { Anchor: (Width: 48, Height: 48); SlotsPerRow: 1; AreItemsDraggable: false; HitTestVisible: false; Style: (SlotSize: 44, SlotIconSize: 40); } $C.@SecondaryTextButton #Load0 { Anchor: (Width: 580, Height: 44); Text: "Load"; } }
