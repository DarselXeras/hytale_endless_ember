$C = "../../Common.ui";
Group { Anchor: (Width: 1100, Height: 800); Background: #0e1822; Padding: 20; LayoutMode: Top;
Label #Title { Anchor: (Height: 30); Text: "EMBER CASTING STATION"; Style: (FontSize: 14, TextColor: #dfc797); }
Group { LayoutMode: Left; Anchor: (Height: 40); $C.@SecondaryTextButton #Tab { Anchor: (Width: 180, Height: 34, Right: 5); Text: "Reserve inventory"; }$C.@SecondaryTextButton #Metal { Anchor: (Width: 260, Height: 34, Right: 5); Text: "Casting metal: Copper"; }$C.@SecondaryTextButton #Close { Anchor: (Width: 125, Height: 34, Right: 5); Text: "Close"; } }
Label #Status { Anchor: (Height: 24); Text: "Ready"; Style: (FontSize: 14, TextColor: #dfc797); }
Label #Mode { Anchor: (Height: 24); Text: "Casting"; Style: (FontSize: 14, TextColor: #dfc797); }
Group #ReserveTabs { Visible: false; LayoutMode: Left; Anchor: (Height: 40); $C.@SecondaryTextButton #Reserve0 { Anchor: (Width: 85, Height: 34, Right: 5); Text: "1"; }$C.@SecondaryTextButton #Reserve1 { Anchor: (Width: 85, Height: 34, Right: 5); Text: "2"; }$C.@SecondaryTextButton #Reserve2 { Anchor: (Width: 85, Height: 34, Right: 5); Text: "3"; }$C.@SecondaryTextButton #Reserve3 { Anchor: (Width: 85, Height: 34, Right: 5); Text: "4"; }$C.@SecondaryTextButton #Reserve4 { Anchor: (Width: 85, Height: 34, Right: 5); Text: "5"; }$C.@SecondaryTextButton #Reserve5 { Anchor: (Width: 85, Height: 34, Right: 5); Text: "6"; }$C.@SecondaryTextButton #Reserve6 { Anchor: (Width: 85, Height: 34, Right: 5); Text: "7"; }$C.@SecondaryTextButton #Reserve7 { Anchor: (Width: 85, Height: 34, Right: 5); Text: "8"; }$C.@SecondaryTextButton #Reserve8 { Anchor: (Width: 85, Height: 34, Right: 5); Text: "9"; }$C.@SecondaryTextButton #Reserve9 { Anchor: (Width: 85, Height: 34, Right: 5); Text: "10"; } }
Group #MountedArea { LayoutMode: Top; Anchor: (Height: 184);
Label #MountedLabel { Anchor: (Height: 22); Text: "MOUNTED CELLS - FIRST PRIORITY"; Style: (FontSize: 14, TextColor: #dfc797); }
Group { LayoutMode: Left; Anchor: (Left: 0, Width: 960, Height: 54); Label #H0 { Anchor: (Width: 92, Height: 54, Right: 4); Text: "Copper"; HitTestVisible: false; Style: (FontSize: 11, TextColor: #dfc797, HorizontalAlignment: Center); }Label #H1 { Anchor: (Width: 92, Height: 54, Right: 4); Text: "Iron"; HitTestVisible: false; Style: (FontSize: 11, TextColor: #dfc797, HorizontalAlignment: Center); }Label #H2 { Anchor: (Width: 92, Height: 54, Right: 4); Text: "Silver"; HitTestVisible: false; Style: (FontSize: 11, TextColor: #dfc797, HorizontalAlignment: Center); }Label #H3 { Anchor: (Width: 92, Height: 54, Right: 4); Text: "Gold"; HitTestVisible: false; Style: (FontSize: 11, TextColor: #dfc797, HorizontalAlignment: Center); }Label #H4 { Anchor: (Width: 92, Height: 54, Right: 4); Text: "Cobalt"; HitTestVisible: false; Style: (FontSize: 11, TextColor: #dfc797, HorizontalAlignment: Center); }Label #H5 { Anchor: (Width: 92, Height: 54, Right: 4); Text: "Thorium"; HitTestVisible: false; Style: (FontSize: 11, TextColor: #dfc797, HorizontalAlignment: Center); }Label #H6 { Anchor: (Width: 92, Height: 54, Right: 4); Text: "Adamantite"; HitTestVisible: false; Style: (FontSize: 11, TextColor: #dfc797, HorizontalAlignment: Center); }Label #H7 { Anchor: (Width: 92, Height: 54, Right: 4); Text: "Mithril"; HitTestVisible: false; Style: (FontSize: 11, TextColor: #dfc797, HorizontalAlignment: Center); }Label #H8 { Anchor: (Width: 92, Height: 54, Right: 4); Text: "Onyxium"; HitTestVisible: false; Style: (FontSize: 11, TextColor: #dfc797, HorizontalAlignment: Center); }Label #H9 { Anchor: (Width: 92, Height: 54, Right: 4); Text: "Prisma"; HitTestVisible: false; Style: (FontSize: 11, TextColor: #dfc797, HorizontalAlignment: Center); } }
ItemGrid #Mounted { Anchor: (Left: 0, Width: 960, Height: 96); SlotsPerRow: 10; AreItemsDraggable: true; AllowMaxStackDraggableItems: true; DisplayItemQuantity: true; HitTestVisible: true; ShowScrollbar: false; Style: (SlotSize: 92, SlotIconSize: 84, SlotSpacing: 4, SlotBackground: "../../Common/BlockSelectorSlotBackground.png"); }
}
Group { LayoutMode: Left; Anchor: (Height: 374);
Group { LayoutMode: Top; Anchor: (Width: 560, Right: 20);
Group #Workshop { LayoutMode: Top; Anchor: (Height: 232);
Label #InputsLabel { Anchor: (Height: 22); Text: "INPUTS"; Style: (FontSize: 14, TextColor: #dfc797); }
Group { LayoutMode: Left; Anchor: (Left: 0, Width: 408, Height: 22); Label #I0 { Anchor: (Width: 64, Height: 22, Right: 4); Text: "Mold"; Style: (FontSize: 11, TextColor: #b8c8d8, HorizontalAlignment: Center); }Label #I1 { Anchor: (Width: 64, Height: 22, Right: 4); Text: "Cell"; Style: (FontSize: 11, TextColor: #b8c8d8, HorizontalAlignment: Center); }Label #I2 { Anchor: (Width: 64, Height: 22, Right: 4); Text: "Ingots"; Style: (FontSize: 11, TextColor: #b8c8d8, HorizontalAlignment: Center); }Label #I3 { Anchor: (Width: 64, Height: 22, Right: 4); Text: "Extra"; Style: (FontSize: 11, TextColor: #b8c8d8, HorizontalAlignment: Center); }Label #I4 { Anchor: (Width: 64, Height: 22, Right: 4); Text: "Extra"; Style: (FontSize: 11, TextColor: #b8c8d8, HorizontalAlignment: Center); }Label #I5 { Anchor: (Width: 64, Height: 22, Right: 4); Text: "Extra"; Style: (FontSize: 11, TextColor: #b8c8d8, HorizontalAlignment: Center); } }
ItemGrid #Inputs { Anchor: (Left: 0, Width: 408, Height: 68); SlotsPerRow: 6; AreItemsDraggable: true; AllowMaxStackDraggableItems: true; DisplayItemQuantity: true; HitTestVisible: true; ShowScrollbar: false; Style: (SlotSize: 64, SlotIconSize: 56, SlotSpacing: 4, SlotBackground: "../../Common/BlockSelectorSlotBackground.png"); }
Group { Anchor: (Height: 18); }
Group { LayoutMode: Left; Anchor: (Height: 102);
Group { LayoutMode: Top; Anchor: (Width: 184, Height: 100); Label #OutputLabel { Anchor: (Height: 22); Text: "PRODUCTS"; Style: (FontSize: 14, TextColor: #dfc797); }ItemGrid #Products { Anchor: (Left: 0, Width: 136, Height: 68); SlotsPerRow: 2; AreItemsDraggable: true; AllowMaxStackDraggableItems: true; DisplayItemQuantity: true; HitTestVisible: true; ShowScrollbar: false; Style: (SlotSize: 64, SlotIconSize: 56, SlotSpacing: 4, SlotBackground: "../../Common/BlockSelectorSlotBackground.png"); } }
Group { LayoutMode: Top; Anchor: (Width: 140, Height: 100); Label #EmptyLabel { Anchor: (Height: 22); Text: "EMPTY CELLS"; Style: (FontSize: 14, TextColor: #dfc797); }ItemGrid #Empties { Anchor: (Left: 0, Width: 68, Height: 68); SlotsPerRow: 1; AreItemsDraggable: true; AllowMaxStackDraggableItems: true; DisplayItemQuantity: true; HitTestVisible: true; ShowScrollbar: false; Style: (SlotSize: 64, SlotIconSize: 56, SlotSpacing: 4, SlotBackground: "../../Common/BlockSelectorSlotBackground.png"); } }
Group { LayoutMode: Top; Anchor: (Width: 140, Height: 100); Label #FuelLabel { Anchor: (Height: 22); Text: "FUEL"; Style: (FontSize: 14, TextColor: #dfc797); }ItemGrid #Fuel { Anchor: (Left: 0, Width: 68, Height: 68); SlotsPerRow: 1; AreItemsDraggable: true; AllowMaxStackDraggableItems: true; DisplayItemQuantity: true; HitTestVisible: true; ShowScrollbar: false; Style: (SlotSize: 64, SlotIconSize: 56, SlotSpacing: 4, SlotBackground: "../../Common/BlockSelectorSlotBackground.png"); } }
} }
Group #Reserve { Visible: false; LayoutMode: Top; Anchor: (Height: 232);
Label #ReserveLabel { Anchor: (Height: 22); Text: "RESERVE - AFTER MOUNTED CELLS"; Style: (FontSize: 14, TextColor: #dfc797); }
ItemGrid #ReserveGrid { Anchor: (Left: 0, Width: 544, Height: 204); SlotsPerRow: 8; AreItemsDraggable: true; AllowMaxStackDraggableItems: true; DisplayItemQuantity: true; HitTestVisible: true; ShowScrollbar: false; Style: (SlotSize: 64, SlotIconSize: 56, SlotSpacing: 4, SlotBackground: "../../Common/BlockSelectorSlotBackground.png"); }
}
Group { LayoutMode: Left; Anchor: (Height: 40); $C.@SecondaryTextButton #Cast { Anchor: (Width: 110, Height: 34, Right: 5); Text: "Cast"; }$C.@SecondaryTextButton #Fill { Anchor: (Width: 150, Height: 34, Right: 5); Text: "Fill cell"; }$C.@SecondaryTextButton #Drain { Anchor: (Width: 150, Height: 34, Right: 5); Text: "Drain cell"; } }
Group { LayoutMode: Left; Anchor: (Height: 40); $C.@SecondaryTextButton #One { Anchor: (Width: 75, Height: 34, Right: 5); Text: "1"; }$C.@SecondaryTextButton #Ten { Anchor: (Width: 75, Height: 34, Right: 5); Text: "10"; }$C.@SecondaryTextButton #All { Anchor: (Width: 85, Height: 34, Right: 5); Text: "All"; }$C.@SecondaryTextButton #Start { Anchor: (Width: 120, Height: 34, Right: 5); Text: "Start"; }$C.@SecondaryTextButton #Stop { Anchor: (Width: 120, Height: 34, Right: 5); Text: "Stop"; } }
Label #Selection { Anchor: (Height: 40); Text: "Drag items to a slot. Holders take one cell."; Style: (FontSize: 14, TextColor: #dfc797); }
}
Group { LayoutMode: Top; Anchor: (Width: 480);
Label #InventoryLabel { Anchor: (Height: 22); Text: "YOUR INVENTORY"; Style: (FontSize: 14, TextColor: #dfc797); }
ItemGrid #PlayerGrid { Anchor: (Left: 0, Width: 468, Height: 208); SlotsPerRow: 9; AreItemsDraggable: true; AllowMaxStackDraggableItems: true; DisplayItemQuantity: true; HitTestVisible: true; ShowScrollbar: true; Style: (SlotSize: 48, SlotIconSize: 40, SlotSpacing: 4, SlotBackground: "../../Common/BlockSelectorSlotBackground.png"); }
ItemGrid #Hotbar { Anchor: (Left: 0, Width: 468, Height: 52); SlotsPerRow: 9; AreItemsDraggable: true; AllowMaxStackDraggableItems: true; DisplayItemQuantity: true; HitTestVisible: true; ShowScrollbar: false; Style: (SlotSize: 48, SlotIconSize: 40, SlotSpacing: 4, SlotBackground: "../../Common/BlockSelectorSlotBackground.png"); }
Group { LayoutMode: Left; Anchor: (Height: 40); $C.@SecondaryTextButton #Prev { Anchor: (Width: 150, Height: 34, Right: 5); Text: "Inventory"; }$C.@SecondaryTextButton #Next { Anchor: (Width: 150, Height: 34, Right: 5); Text: "Backpack"; } }
} } }
