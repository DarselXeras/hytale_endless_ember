$C = "../../Common.ui";
Group { Anchor: (Width: 1100, Height: 900); Background: #0e1822; Padding: 20; LayoutMode: Top;
Label #Title { Anchor: (Height: 30); Text: "EMBER CASTING STATION"; Style: (FontSize: 14, TextColor: #dfc797); }
Group { LayoutMode: Left; Anchor: (Height: 38); $C.@SecondaryTextButton #Tab { Anchor: (Width: 180, Height: 34, Right: 5); Text: "Reserve inventory"; }$C.@SecondaryTextButton #Metal { Anchor: (Width: 180, Height: 34, Right: 5); Text: "Metal: Copper"; }$C.@SecondaryTextButton #Close { Anchor: (Width: 125, Height: 34, Right: 5); Text: "Close"; } }
