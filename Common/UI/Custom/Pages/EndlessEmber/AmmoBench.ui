}
Label #Weapon { Anchor: (Height: 26); Style: (FontSize: 17, TextColor: #dfc797); }
Group { LayoutMode: Left; Anchor: (Height: 356);
Group { LayoutMode: Top; Anchor: (Width: 420);
Group #RecipeRow0 { LayoutMode: Left; Anchor: (Height: 46); ItemGrid #RecipeIcon0 { Anchor: (Width: 44, Height: 44); SlotsPerRow: 1; AreItemsDraggable: false; HitTestVisible: false; Style: (SlotSize: 42, SlotIconSize: 40); } $C.@SecondaryTextButton #Recipe0 { Anchor: (Width: 364, Height: 42); Text: "Ammo"; } }
