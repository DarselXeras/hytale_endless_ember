Group #RecipeRow4 { LayoutMode: Left; Anchor: (Height: 46); ItemGrid #RecipeIcon4 { Anchor: (Width: 44, Height: 44); SlotsPerRow: 1; AreItemsDraggable: false; HitTestVisible: false; Style: (SlotSize: 42, SlotIconSize: 40); } $C.@SecondaryTextButton #Recipe4 { Anchor: (Width: 364, Height: 42); Text: "Ammo"; } }
