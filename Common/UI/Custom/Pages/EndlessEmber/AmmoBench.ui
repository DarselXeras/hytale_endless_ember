$C = "../../Common.ui";
Group { Anchor: (Width: 1060, Height: 840); Background: #0e1822; Padding: 18; LayoutMode: Top;
Label #Title { Anchor: (Height: 30); Style: (FontSize: 21, TextColor: #dfc797); }
Group { LayoutMode: Left; Anchor: (Height: 36); $C.@SecondaryTextButton #Prev { Anchor: (Width: 170, Height: 32); Text: "Previous"; } Label #Page { Anchor: (Width: 180, Height: 32); Style: (FontSize: 16, TextColor: #ffffff, HorizontalAlignment: Center); } $C.@SecondaryTextButton #Next { Anchor: (Width: 170, Height: 32); Text: "Next"; } }
Group { LayoutMode: Left; Anchor: (Height: 50);
Group #CategoryRow0 { LayoutMode: Left; Anchor: (Width: 338, Height: 48); ItemGrid #CategoryIcon0 { Anchor: (Width: 46, Height: 46); SlotsPerRow: 1; AreItemsDraggable: false; HitTestVisible: false; Style: (SlotSize: 44, SlotIconSize: 42); } $C.@SecondaryTextButton #Category0 { Anchor: (Width: 282, Height: 44); Text: "Weapon"; } }
